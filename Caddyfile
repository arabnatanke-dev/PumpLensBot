{$PUBLIC_HOST} {
    encode zstd gzip
    reverse_proxy app:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    # Access logs stay disabled because one-time Mini App tokens are in the URL.
    # Access logs отключены: URL содержит одноразовые токены Mini App.
}
