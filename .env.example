# Runtime / Среда выполнения
APP_ENV=development
LOG_LEVEL=INFO
SETTINGS_FILE=settings.yaml

# Telegram is optional for the first CLI milestone.
# Telegram необязателен для первого CLI-этапа.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_USER_IDS=

# User read-only Binance credentials are never stored here.
# Read-only ключи пользователей Binance никогда не хранятся здесь.
DATABASE_URL=postgresql+asyncpg://pumplens:replace_with_a_long_random_password@postgres:5432/pumplens
POSTGRES_PASSWORD=replace_with_a_long_random_password
CREDENTIAL_MASTER_KEY=
PUBLIC_BASE_URL=https://bot.example.com
PUBLIC_HOST=bot.example.com

HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
